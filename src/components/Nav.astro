---
import { site } from '../data/site';
import { projects } from '../data/projects';
import Monogram from './Monogram.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const links = [
  { label: 'Work', href: `${home}#work`, count: String(projects.length).padStart(2, '0') },
  { label: 'About', href: `${home}#about` },
  { label: 'Contact', href: `${home}#contact` },
];
---
<header class="nav" data-nav>
  <a class="nav__brand" href={home} aria-label={`${site.name}, home`} data-brand>
    <span class="nav__mark"><Monogram class="nav__mono" /></span>
    <span class="nav__name">{site.name}</span>
  </a>
  <p class="nav__clock label" aria-label="Local time in Belgium"><span>BE</span> <time data-clock>--:--</time></p>
  <nav class="nav__links" aria-label="Primary">
    {links.map((l) => (
      <a class="nav__link" href={l.href} aria-label={l.label}><span class="nav__label" data-label={l.label}><span data-scramble-hover aria-hidden="true">{l.label}</span></span>{l.count && <sup>{l.count}</sup>}</a>
    ))}
    {site.resumeUrl && <a class="nav__link" href={site.resumeUrl} target="_blank" rel="noreferrer" aria-label="Résumé"><span class="nav__label" data-label="Résumé"><span data-scramble-hover aria-hidden="true">Résumé</span></span></a>}
  </nav>
  <button class="nav__burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
    <span class="sr-only">Menu</span><i></i><i></i>
  </button>
</header>

<div class="menu" id="menu" data-menu hidden>
  <ul class="menu__list">
    {links.map((l, i) => (
      <li style={`--i:${i}`}><a href={l.href} data-menu-link><span class="label">0{i + 1}</span>{l.label}</a></li>
    ))}
  </ul>
  <div class="menu__foot">
    <a class="label" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</div>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 40;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 22px var(--gutter);
    color: var(--ink);
    background: linear-gradient(rgb(12 10 9 / .7), rgb(12 10 9 / 0));
  }
  .nav__brand { display: inline-flex; align-items: center; gap: 14px; justify-self: start; }
  .nav__brand :global(.nav__mono) { width: clamp(34px, calc(var(--u) * 2.5), 44px); height: auto; aspect-ratio: 1; color: var(--ink); transition: transform .9s var(--ease), color .35s var(--ease-state); }
  /* hover: a full spin with a bounce, ember fill, and a ring that escapes outward */
  .nav__mark { position: relative; display: inline-grid; place-items: center; }
  .nav__mark::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%; border: 1.5px solid var(--ember);
    opacity: 0; transform: scale(1); pointer-events: none;
  }
  .nav__brand:hover :global(.nav__mono) { transform: rotate(360deg) scale(1.08); color: var(--ember); transition: transform 1.1s cubic-bezier(.34, 1.56, .64, 1), color .3s; }
  .nav__brand:hover .nav__mark::after { animation: mark-ring .9s var(--ease) both; }
  @keyframes mark-ring { 0% { opacity: .9; transform: scale(1); } 100% { opacity: 0; transform: scale(2.4); } }
  .nav__name { transition: letter-spacing .6s var(--ease), color .3s; }
  .nav__brand:hover .nav__name { letter-spacing: .02em; }
  .nav__name { font: 500 clamp(14px, calc(var(--u) * 1), 17px)/1 var(--sans); letter-spacing: -.005em; }
  .nav__clock { color: var(--ink-3); }
  .nav__clock span { color: var(--ember); }
  .nav__links { display: flex; gap: 28px; justify-self: end; }
  .nav__link { font: 450 clamp(14px, calc(var(--u) * 1.05), 18px)/1 var(--sans); letter-spacing: -.005em; transition: color .3s var(--ease-state); }
  /* The original label sizes the link; scrambled glyphs cannot move its neighbours. */
  .nav__label { position: relative; display: inline-block; white-space: nowrap; }
  .nav__label::before { content: attr(data-label); visibility: hidden; }
  .nav__label [data-scramble-hover] { position: absolute; inset: 0; overflow: clip; }
  /* same hover as the footer socials: ember + the label decodes */
  .nav__link:hover { color: var(--ember); }
  .nav__link sup { font: 450 9px/0 var(--mono); margin-left: 3px; opacity: .6; vertical-align: super; }
  .nav__burger { display: none; justify-self: end; width: 44px; height: 44px; position: relative; }
  .nav__burger i { position: absolute; left: 10px; right: 10px; height: 1.5px; background: currentColor; transition: transform .45s var(--ease); }
  .nav__burger i:nth-of-type(1) { top: 18px; }
  .nav__burger i:nth-of-type(2) { top: 25px; }
  .nav__burger[aria-expanded='true'] i:nth-of-type(1) { transform: translateY(3.5px) rotate(45deg); }
  .nav__burger[aria-expanded='true'] i:nth-of-type(2) { transform: translateY(-3.5px) rotate(-45deg); }

  .menu {
    position: fixed; inset: 0; z-index: 39; background: var(--bg);
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 96px var(--gutter) max(32px, env(safe-area-inset-bottom));
    clip-path: inset(0 0 100% 0); transition: clip-path .6s var(--ease);
  }
  .menu.is-open { clip-path: inset(0 0 0 0); }
  .menu__list li { overflow: hidden; border-top: 1px solid var(--line); }
  .menu__list a {
    display: flex; align-items: baseline; gap: 16px; padding: 14px 0;
    font: 500 clamp(44px, calc(var(--u) * 13), 72px)/1 var(--sans); letter-spacing: -.055em;
    transform: translateY(105%); transition: transform .7s var(--ease); transition-delay: calc(.12s + var(--i) * .06s);
  }
  .menu.is-open .menu__list a { transform: none; }
  .menu__foot { margin-top: 32px; }

  @media (max-width: 1023px) {
    .nav__clock { display: none; }
    .nav { grid-template-columns: 1fr auto; }
  }
  @media (max-width: 767px) {
    .nav { padding: 14px var(--gutter); }
    .nav__links { display: none; }
    .nav__burger { display: block; }
  }
</style>
