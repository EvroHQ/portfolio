---
import { projects } from '../data/projects';
import ProjectCover from './ProjectCover.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="work" id="work" data-section="work" aria-labelledby="work-title">
  <div class="work__pin" data-work-pin>
    <header class="work__head">
      <p class="label"><b>03</b> — <span data-scramble>The reel</span></p>
      <p class="label work__count"><span data-work-index>01</span> / {pad(projects.length)}</p>
    </header>

    <div class="work__track" data-work-track>
      <div class="work__intro">
        <h2 id="work-title" class="display">Selected<br /><span class="accent">work</span></h2>
        <p class="work__lede">Five records from the last three years — an audio engine, a desktop app, a slot game, a crowdfunding platform and a theme thousands of developers code in. Hover to play them. Click to step inside.</p>
      </div>

      {projects.map((p) => (
        <article class="slide" data-slide data-slug={p.slug}>
          <a class="slide__link" href={`${base}/work/${p.slug}/`} data-slide-link aria-label={`${p.title} — case study`}>
            <div class="slide__media" data-slide-media>
              <ProjectCover project={p} sizes="(max-width: 1023px) 92vw, 52vw" />
            </div>
            <div class="slide__meta">
              <span class="label slide__index">{p.index} · {p.year}</span>
              <h3 class="slide__title">{p.title}</h3>
              <p class="slide__kind">{p.kind} <span class="label">{p.stat}</span></p>
            </div>
          </a>
        </article>
      ))}

      <div class="work__outro">
        <p class="display">More<br />soon<span class="accent">.</span></p>
        <a class="pill" href="https://github.com/evrohq" target="_blank" rel="noreferrer" data-magnetic>
          Everything on GitHub
          <span class="pill__dot"><svg viewBox="0 0 14 14" fill="none"><path d="M3 11 11 3M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.4" /></svg></span>
        </a>
      </div>
    </div>

    <div class="work__progress" aria-hidden="true"><span data-work-progress></span></div>
  </div>
</section>

<style>
  .work { position: relative; }
  .work__pin { position: relative; height: 100vh; height: 100svh; overflow: hidden; }
  .work__head { position: absolute; left: var(--gutter); right: calc(var(--gutter) + 90px); top: 96px; display: flex; justify-content: space-between; z-index: 2; }
  .work__head b { color: var(--ember); }
  .work__count { font-variant-numeric: tabular-nums; }
  .work__track { position: absolute; top: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: clamp(64px, calc(var(--u) * 8), 160px); padding: 0 var(--gutter); will-change: transform; }
  .work__intro { flex: none; width: calc(var(--fw) * .4); display: grid; gap: 32px; }
  .work__lede { max-width: 28rem; color: var(--ink-2); font-size: clamp(17px, calc(var(--u) * 1.3), 24px); line-height: 1.5; letter-spacing: -.015em; }

  .slide { flex: none; position: relative; }
  .slide__link { display: block; }
  /* one shared height keeps the reel aligned; each width follows its image's ratio (no cropping) */
  .slide__media { width: fit-content; height: min(calc(var(--u) * 29), 52vh); }
  .slide__media :global(.cover) { height: 100%; width: auto; transition: opacity .6s var(--ease); }
  .slide.is-gl .slide__media :global(.cover) { opacity: 0; }
  .slide__meta { position: relative; margin-top: 28px; pointer-events: none; }
  .slide__index { display: block; margin: 0 0 10px; color: var(--ember); }
  .slide__title {
    font: 600 clamp(40px, calc(var(--u) * 5.8), 132px)/.86 var(--sans); letter-spacing: -.065em; text-transform: uppercase;
    transition: transform .8s var(--ease), letter-spacing .8s var(--ease);
  }
  .slide__link:hover .slide__title { transform: translateX(18px); letter-spacing: -.045em; }
  .slide__kind { margin-top: 14px; font-size: clamp(15px, calc(var(--u) * 1.15), 21px); color: var(--ink-2); display: flex; gap: 16px; align-items: baseline; flex-wrap: wrap; }

  .work__outro { flex: none; display: grid; gap: 40px; justify-items: start; padding-right: calc(var(--u) * 12); }
  .work__progress { position: absolute; left: var(--gutter); right: calc(var(--gutter) + 90px); bottom: 40px; height: 1px; background: var(--line); }
  .work__progress span { display: block; height: 100%; background: var(--ember); transform-origin: left; transform: scaleX(0); }

  /* touch & small screens: a vertical reel, no pinning */
  @media (max-width: 1023px) {
    .work__pin { height: auto; overflow: visible; padding: 140px 0 80px; }
    .work__head { top: 80px; right: var(--gutter); }
    .work__track { position: relative; flex-direction: column; align-items: stretch; gap: 88px; }
    .work__intro { width: 100%; }
    .slide { align-self: stretch; }
    .slide__media { width: 100%; height: auto; }
    .slide__media :global(.cover) { width: 100%; height: auto; }
    .work__outro { padding: 0; }
    .work__progress { display: none; }
  }
</style>
