---
import { site } from '../data/site';
import Footer from './Footer.astro';
---
<section class="contact" id="contact" data-section="contact" aria-labelledby="contact-title">
  <div class="contact__in wrap">
    <p class="label"><b>05</b> — <span data-scramble>Output</span></p>
    <h2 id="contact-title" class="display contact__title" data-split>Let's make<br />it sound<br /><span class="accent">right.</span></h2>
    <div class="contact__row">
      <p class="contact__status label"><i aria-hidden="true"></i>{site.status}</p>
      <div class="contact__mail">
        <a class="contact__email" href={`mailto:${site.email}`} data-magnetic="0.06">{site.email}</a>
        <button class="contact__copy label" type="button" data-copy={site.email}><span data-copy-label>Copy</span></button>
      </div>
    </div>
    <ul class="contact__socials">
      {site.socials.map((s, i) => (
        <li>
          <a href={s.href} target="_blank" rel="noreferrer">
            <span class="social__n label">{String(i + 1).padStart(2, '0')}</span>
            <span class="social__name" data-scramble-hover>{s.label}</span>
            <span class="social__handle label">{s.handle}</span>
            <span class="social__arrow" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M2 10 10 2M3.5 2H10v6.5" fill="none" stroke="currentColor" stroke-width="1.2" /></svg></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <Footer />
</section>

<style>
  .contact { position: relative; min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; padding-top: clamp(120px, calc(var(--u) * 14), 200px); }
  .contact__in { flex: 1; padding-right: calc(var(--gutter) + 90px); }
  .contact b { color: var(--ember); }
  .contact__title { margin-top: 28px; font-size: min(calc(var(--u) * 9.6), 15vh, 180px); }
  .contact__row { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-top: clamp(56px, calc(var(--u) * 8), 120px); flex-wrap: wrap; }
  .contact__status { display: inline-flex; align-items: center; gap: 10px; color: var(--ink-2); }
  .contact__status i { width: 7px; height: 7px; border-radius: 50%; background: var(--ember); box-shadow: 0 0 0 4px rgb(255 90 31 / .18); }
  .contact__mail { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .contact__email { display: inline-block; font: 500 clamp(22px, calc(var(--u) * 3.6), 76px)/1.1 var(--sans); letter-spacing: -.045em; overflow-wrap: anywhere; background: linear-gradient(var(--ember), var(--ember)) 0 100% / 0 2px no-repeat; transition: background-size .6s var(--ease), color .3s; }
  .contact__email:hover { background-size: 100% 2px; }
  .contact__copy { height: 36px; padding: 0 14px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink-2); transition: border-color .3s, color .3s; }
  .contact__copy:hover { border-color: var(--ember); color: var(--ink); }
  /* editorial list: one big row per link */
  .contact__socials { margin-top: clamp(48px, calc(var(--u) * 5), 80px); border-top: 1px solid var(--line); }
  .contact__socials li { border-bottom: 1px solid var(--line); }
  .contact__socials a {
    display: grid; grid-template-columns: 64px 1fr auto 56px; align-items: center; gap: 24px;
    padding: clamp(16px, calc(var(--u) * 1.4), 26px) 0; color: var(--ink);
    transition: color .3s var(--ease-state);
  }
  .social__name { font: 500 clamp(30px, calc(var(--u) * 4), 72px)/1 var(--sans); letter-spacing: -.05em; transition: transform .7s var(--ease); }
  .social__handle { color: var(--ink-3); transition: color .3s; }
  .social__arrow { justify-self: end; display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--line); border-radius: 50%; transition: background-color .35s, border-color .35s, transform .6s var(--ease); }
  .social__arrow svg { width: 13px; height: 13px; }
  .contact__socials a:hover { color: var(--ember); }
  .contact__socials a:hover .social__name { transform: translateX(16px); }
  .contact__socials a:hover .social__handle { color: var(--ink-2); }
  .contact__socials a:hover .social__arrow { background: var(--ember); border-color: var(--ember); color: var(--bg); transform: rotate(45deg); }
  @media (max-width: 1023px) { .contact__in { padding-right: var(--gutter); } }
  @media (max-width: 700px) {
    .contact__email { font-size: min(5.4vw, 26px); overflow-wrap: normal; white-space: nowrap; }
    .social__name { font-size: clamp(24px, 7vw, 34px); }
    .contact__socials a { grid-template-columns: 36px 1fr 44px; gap: 14px; }
    .social__handle { display: none; }
    .social__arrow { width: 40px; height: 40px; }
  }
  @media (max-width: 560px) { .contact__title { font-size: calc(var(--u) * 15); } }
</style>
