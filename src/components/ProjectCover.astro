---
import { Picture } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  sizes?: string;
  eager?: boolean;
  class?: string;
  /** full-bleed: fill the parent, crop from the centre (matches the WebGL expand) */
  bleed?: boolean;
}
const { project, sizes = '(max-width: 767px) 100vw, 40vw', eager = false, class: className = '', bleed = false } = Astro.props;
const par = bleed ? 'xMidYMid slice' : 'xMidYMid meet';
// every frame takes its image's own ratio, so nothing is ever cropped
const ar = typeof project.cover !== 'string' ? project.cover.width / project.cover.height : 1.6;

// deterministic pseudo-random so the plates render identically every build
const rng = (seed: number) => () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

function waveBars(seed: number, n: number, w: number, h: number, shape: (x: number) => number) {
  const r = rng(seed);
  const bw = w / n;
  let d = '';
  for (let i = 0; i < n; i++) {
    const x = i / n;
    const a = Math.max(0.04, Math.min(1, shape(x) * (0.45 + r() * 0.55)));
    const bh = a * h;
    d += `M${(i * bw).toFixed(1)} ${((h - bh) / 2).toFixed(1)}h${(bw * 0.55).toFixed(1)}v${bh.toFixed(1)}h-${(bw * 0.55).toFixed(1)}z`;
  }
  return d;
}

const stems = [
  { name: 'KICK', shape: (x: number) => (Math.floor(x * 32) % 2 === 0 ? 0.95 : 0.15) },
  { name: 'BASS', shape: (x: number) => 0.55 + 0.35 * Math.sin(x * 18) },
  { name: 'DRUMS', shape: (x: number) => 0.4 + 0.5 * Math.abs(Math.sin(x * 40)) },
  { name: 'KEYS', shape: (x: number) => 0.35 + 0.3 * Math.sin(x * 6 + 1) },
  { name: 'VOX', shape: (x: number) => (x > 0.22 && x < 0.9 ? 0.5 + 0.4 * Math.sin(x * 11) : 0.05) },
  { name: 'FX', shape: (x: number) => 0.15 + 0.6 * x * x },
].map((s, i) => ({ ...s, d: waveBars(17 + i * 31, 72, 720, 64, s.shape) }));
const master = waveBars(911, 120, 520, 360, (x) => 0.78 + 0.18 * Math.sin(x * 9));

const lufs = [
  ['House / Techno', '−8 to −9'],
  ['EDM', '−9'],
  ['Hip-Hop', '−10'],
  ['Pop', '−11'],
  ['Rock', '−12'],
  ['Acoustic', '−14'],
];
const vt = `cover-${project.slug}`;
---
<figure class:list={['cover', { 'cover--bleed': bleed }, className]} style={`--ar:${ar.toFixed(4)}`}>
  {typeof project.cover !== 'string' ? (
    <Picture
      src={project.cover}
      alt={project.coverAlt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1440, 1920]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="cover__img"
    />
  ) : project.cover === 'plate-mix' ? (
    <svg class="cover__plate" viewBox="0 0 1600 1000" preserveAspectRatio={par} role="img" aria-label={project.coverAlt}>
      <rect width="1600" height="1000" fill="#111113" />
      <g font-family="Geist Mono Variable, Geist Mono, monospace" font-size="15" letter-spacing="2.4" fill="#ece8e1">
        {stems.map((s, i) => (
          <g transform={`translate(96 ${150 + i * 112})`}>
            <text y="38" opacity=".45">{`0${i + 1}`}</text>
            <text x="44" y="38" opacity=".8">{s.name}</text>
            <path d={s.d} transform="translate(150 0)" fill="#ece8e1" opacity=".55" />
            <path d={`M876 32 C 960 32, 980 ${500 - (150 + i * 112) + 0}, 1010 ${500 - (150 + i * 112)}`} fill="none" stroke="#ece8e1" stroke-opacity=".14" />
          </g>
        ))}
      </g>
      <line x1="1010" y1="140" x2="1010" y2="860" stroke="#ece8e1" stroke-opacity=".14" />
      <path d={master} transform="translate(1040 320)" fill="#0bc0ee" />
      <g font-family="Geist Mono Variable, Geist Mono, monospace" font-size="15" letter-spacing="2.4" fill="#ece8e1">
        <text x="1040" y="290" opacity=".8">MASTER</text>
        <text x="1560" y="290" text-anchor="end" fill="#0bc0ee">−9.0 LUFS</text>
        <text x="1040" y="730" opacity=".45">TRUE PEAK</text>
        <text x="1560" y="730" text-anchor="end" opacity=".8">≤ −1.0 dBTP</text>
        <text x="96" y="96" opacity=".45">STEMS → ANALYZE → MIX → MASTER</text>
        <text x="1040" y="790" opacity=".45">GENRE · {lufs[0][0].toUpperCase()}</text>
        <text x="1560" y="790" text-anchor="end" opacity=".8">{lufs[0][1]} LUFS</text>
      </g>
    </svg>
  ) : null}
</figure>

<style>
  .cover { position: relative; aspect-ratio: var(--ar, 1.6); overflow: hidden; background: var(--bg-2); border-radius: 6px; }
  .cover :global(img), .cover__plate { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .cover--bleed { aspect-ratio: auto; height: 100%; border-radius: 0; }
  .cover--bleed :global(img) { object-position: center; }
  .cover--bleed::after { display: none; }
  .cover::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgb(236 232 225 / .1); pointer-events: none; }
</style>
