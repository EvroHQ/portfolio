---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Signal lost" page="error">
  <section class="lost wrap" data-section="lost">
    <p class="label"><b>404</b> — No signal</p>
    <h1 class="lost__title">Signal <span class="accent">lost.</span></h1>
    <a class="pill" href={`${base}/`}>
      Back to the start
      <span class="pill__dot"><svg viewBox="0 0 14 14" fill="none"><path d="M1 7h12M7.5 1.5 13 7l-5.5 5.5" stroke="currentColor" stroke-width="1.4" /></svg></span>
    </a>
  </section>
</Base>

<style>
  .lost { min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; gap: 40px; padding-bottom: 64px; }
  .lost__title { font: 500 clamp(64px, calc(var(--u) * 14), 240px)/.88 var(--sans); letter-spacing: -.065em; }
  .lost .pill { align-self: flex-start; }
</style>
